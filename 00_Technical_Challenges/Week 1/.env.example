# Copy this file to `.env` in THIS folder:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The app loads it automatically via python-dotenv.

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
VOYAGE_API_KEY=pa-your-key-here
OPENAI_API_KEY=sk-your-key-here

